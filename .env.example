# GitLab Docusaurus MCP Server Configuration Template

# GitLab instance URL (default: https://gitlab.com)
GITLAB_URL=https://gitlab.com

# Your GitLab Personal Access Token (required)
# Create one at: https://gitlab.com/-/profile/personal_access_tokens
# Required scopes: read_api, read_repository
GITLAB_TOKEN=your_gitlab_token_here

# Your GitLab Project ID (required)
# Find it in your project's Settings > General
GITLAB_PROJECT_ID=your_project_id_here

# Branch to read from (default: main)
GITLAB_BRANCH=main
